# Copy outside source control, e.g. tests/config/accounts.env.
# Use random hex for DB password so it is safe inside the connection URL.
ACCOUNT_ENV=production
ACCOUNT_PORT=7385
ACCOUNT_DB_PASSWORD=replace-with-random-hex
ACCOUNT_DIGEST_SECRET=replace-with-at-least-32-random-bytes
ACCOUNT_OIDC_ISSUER=https://identity.example.com/realms/letsgo
ACCOUNT_OIDC_AUDIENCE=letsgo-api
ACCOUNT_OIDC_JWKS_URL=https://identity.example.com/realms/letsgo/protocol/openid-connect/certs
ACCOUNT_OIDC_ALGORITHM=RS256
ACCOUNT_NATIVE_CLIENT_ID=letsgo-native
ACCOUNT_NATIVE_REDIRECT_URI=http://127.0.0.1:7386/callback
# Optional internal route for discovery/code exchange; must keep the issuer's realm path.
ACCOUNT_OIDC_INTERNAL_URL=
# The admin dashboard (/admin/): its public URL base (Keycloak redirect: <ACCOUNT_PUBLIC_URL>/admin/) and its own public
# Keycloak client (keycloak_setup --client-id letsgo-admin --redirect-uri <ACCOUNT_PUBLIC_URL>/admin/).
ACCOUNT_PUBLIC_URL=https://letsgo.example.com
ACCOUNT_ADMIN_CLIENT_ID=letsgo-admin
# 1 (default): staff need a recent two-step sign-in (keycloak_setup --staff-mfa sets it up for the dashboard client).
ACCOUNT_ADMIN_REQUIRE_MFA=1
# The dashboard's game artwork folder (server/accounts/dashboard/collect_assets.py); optional, never committed.
# (default ../../tests/config/dashboard-assets, relative to compose.yml)
DASHBOARD_ART_DIR=
# The co-op relay container: its admin port is only on the Compose network; random, 32+ characters.
RELAY_ADMIN_TOKEN=replace-with-random-hex
RELAY_BIND=127.0.0.1
# Keycloak (compose profile "identity"), moved from ssrecomp's Johto Online compose: it reuses that database volume, so
# KEYCLOAK_DB_PASSWORD must be the password that database already has (ssrecomp's server/.env).
KEYCLOAK_DB_PASSWORD=replace-with-the-existing-keycloak-db-password
KEYCLOAK_ADMIN_PASSWORD=replace-with-random
KEYCLOAK_URL=http://localhost:8080
